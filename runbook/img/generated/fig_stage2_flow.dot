digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB; nodesep=0.3; ranksep=0.32;
  a [label="Confirm Hazelcast removed\n(hazelcast/disabled returns true)", fillcolor="#DCE6F2"];
  b [label="Update SRS to a version listed for\n26.1.1; confirm search cluster version", fillcolor="#E4DFEC"];
  c [label="Kafka readiness: client 4.0.0 compatibility,\nSystemPulse topic 6 partitions,\nremove DSS delayeditems/dataflowbased/threadspernode", fillcolor="#E2EFDA"];
  d [label="Code readiness: Jakarta EE JARs re-imported,\nprimary keys present (primaryKeyUtility)", fillcolor="#FFF2CC"];
  e [label="Installer job, upgradeType zero-downtime\nrules migrated and upgraded in new rules schema", fillcolor="#E4DFEC"];
  f [label="Rolling restart onto 26.1.1 images;\ndata schema upgrade", fillcolor="#E4DFEC"];
  g [label="Verify Stream provider ExternalKafka / NORMAL,\nsearch index status, queue processors", fillcolor="#E2EFDA"];
  q [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Acceptance\ntests pass?", margin="0.04,0.04", fontsize=9.5];
  ok [label="Close change; hypercare", fillcolor="#E2EFDA"];
  rb [label="Rollback (Section 15)", fillcolor="#F8CBAD"];
  a -> b -> c -> d -> e -> f -> g -> q;
  q -> ok [label="Yes"]; q -> rb [label="No"];

}
