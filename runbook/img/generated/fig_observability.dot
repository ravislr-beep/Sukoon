digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=LR;
  pega [label="Pega web and batch\nlogs, JVM, PDC alerts", fillcolor="#DCE6F2"];
  srs [label="SRS pods\nlogs, latency, errors", fillcolor="#E4DFEC"];
  aks [label="AKS nodes and pods\nContainer Insights", fillcolor="#F2F2F2"];
  ccl [label="Confluent Cloud\nMetrics API, audit log topic", fillcolor="#E2EFDA"];
  srch [label="Search service\nhealth, latency, disk, JVM", fillcolor="#E2EFDA"];
  net [label="Synthetic checks\nDNS, TCP, TLS expiry", fillcolor="#F2F2F2"];
  law [label="Log Analytics workspace\nand Azure Monitor metrics", fillcolor="#F2F2F2"];
  pdc [label="Pega Diagnostic Center", fillcolor="#DCE6F2"];
  siem [label="SIEM", fillcolor="#FCE4D6"];
  dash [label="Platform dashboard\n(7 distinct health signals)", fillcolor="#E2EFDA"];
  alert [label="Alert rules and on-call\nrouting (Section 18)", fillcolor="#E2EFDA"];
  pega -> law; srs -> law; aks -> law; net -> law;
  ccl -> law [label="exporter / connector"];
  srch -> law [label="provider integration"];
  pega -> pdc [style=dashed];
  law -> siem [label="security events"];
  law -> dash; law -> alert;

}
