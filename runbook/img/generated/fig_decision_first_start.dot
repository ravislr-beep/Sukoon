digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB; ranksep=0.3;
  start [label="First start of an environment built from a clone", fillcolor="#DCE6F2"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Installer job completed\nand log reviewed?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Clean-up items in\nSection 10.3 signed off?", margin="0.04,0.04", fontsize=9.5];
  q3 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Stream landing page:\nExternalKafka, NORMAL,\nown prefix?", margin="0.04,0.04", fontsize=9.5];
  q4 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Search landing page:\nSRS connected, own\ncustomerDeploymentId?", margin="0.04,0.04", fontsize=9.5];
  q5 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="No connection attempts to\nPROD or other environments\nin firewall logs?", margin="0.04,0.04", fontsize=9.5];
  q6 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Index build complete,\ncounts match database?", margin="0.04,0.04", fontsize=9.5];
  go [label="GO: release intake", fillcolor="#E2EFDA"];
  stop [label="NO-GO: keep intake held,\nfix, repeat the failed check", fillcolor="#F8CBAD"];
  start -> q1;
  q1 -> q2 [label="Yes"]; q2 -> q3 [label="Yes"]; q3 -> q4 [label="Yes"];
  q4 -> q5 [label="Yes"]; q5 -> q6 [label="Yes"]; q6 -> go [label="Yes"];
  q1 -> stop [label="No"]; q2 -> stop [label="No"]; q3 -> stop [label="No"];
  q4 -> stop [label="No"]; q5 -> stop [label="No"]; q6 -> stop [label="No"];

}
