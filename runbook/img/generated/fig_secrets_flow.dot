digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=LR;
  kv [label="Azure Key Vault\none vault per environment", fillcolor="#FCE4D6"];
  eso [label="External Secrets Operator\n(workload identity)", fillcolor="#FCE4D6"];
  ks [label="Kubernetes secrets\nin pega-<env> and srs-<env>", fillcolor="#F2F2F2"];
  pega [label="Pega web and batch pods\njdbc.external_secret_name\nstream.external_secret_name\npegasearch.srsAuth.external_secret_name", fillcolor="#DCE6F2"];
  inst [label="Installer job\njdbc.external_secret_name", fillcolor="#DCE6F2"];
  srs [label="SRS pods\nsrsStorage.authSecret\nsrsRuntime.ssl.certsSecret", fillcolor="#E4DFEC"];
  kv -> eso [label="read (Key Vault\nSecrets User role)"];
  eso -> ks [label="sync on\nrefreshInterval"];
  ks -> pega; ks -> inst; ks -> srs;

}
