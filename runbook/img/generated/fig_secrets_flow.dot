digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=LR;
  kv [label="Azure Key Vault\nsecrets and certificates", fillcolor="#FCE4D6"];
  eso [label="External Secrets Operator\n(workload identity)", fillcolor="#FCE4D6"];
  ks [label="Kubernetes secrets\n(etcd encrypted with KMS)", fillcolor="#F2F2F2"];
  pega [label="Pega pods\njdbc.external_secret_name\nstream.external_secret_name\nglobal.certificatesSecrets", fillcolor="#DCE6F2"];
  srs [label="SRS pods\nsrsStorage.authSecret\nsrsStorage.certsSecret", fillcolor="#E4DFEC"];
  kv -> eso [label="read (RBAC: Key Vault Secrets User)"];
  eso -> ks [label="sync on refreshInterval"];
  ks -> pega; ks -> srs;

}
