digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB;
  start [label="Rollback trigger raised", fillcolor="#F8CBAD"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Has public DNS been\nswitched to the target?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Have users created or\nchanged cases on the\ntarget?", margin="0.04,0.04", fontsize=9.5];
  a [label="Abort: leave DNS on 8.8,\nrestart 8.8 nodes on the original\ndatabase, re-open intake", fillcolor="#E2EFDA"];
  b [label="Revert DNS to 8.8; restart 8.8\non original database; no data\nreconciliation needed", fillcolor="#E2EFDA"];
  c [label="Business decision required:\nfix forward on 26.1.1, or revert and\nre-key changes made since cutover\n(see reconciliation report)", fillcolor="#FFF2CC"];
  start -> q1;
  q1 -> a [label="No"];
  q1 -> q2 [label="Yes"];
  q2 -> b [label="No"];
  q2 -> c [label="Yes"];

}
