digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB;
  start [label="Select Pega to Kafka authentication", fillcolor="#DCE6F2"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Documented Helm value\nfor the mechanism\n(stream.saslMechanism)?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Security policy forbids\nlong-lived API keys?", margin="0.04,0.04", fontsize=9.5];
  q3 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="OAUTHBEARER proven with\nConfluent in a 26.1.1\nrehearsal?", margin="0.04,0.04", fontsize=9.5];
  plain [label="SASL_SSL + PLAIN\nservice-account API key in Key Vault,\nrotated by runbook (reference design)", fillcolor="#E2EFDA"];
  oauth [label="SASL_SSL + OAUTHBEARER\nper the Pega article", fillcolor="#E2EFDA"];
  exc [label="Exception: PLAIN with short\nrotation until OAUTHBEARER\nis proven", fillcolor="#FFF2CC"];
  start -> q1;
  q1 -> q2 [label="PLAIN: yes"];
  q2 -> plain [label="No"];
  q2 -> q3 [label="Yes"];
  q3 -> oauth [label="Yes"];
  q3 -> exc [label="No"];

}
