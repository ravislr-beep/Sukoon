digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB;
  start [label="Place a non-production environment on shared services", fillcolor="#DCE6F2"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does it run load tests\nor production rehearsals?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Must it match PROD service\ntype, settings and\nnetworking?", margin="0.04,0.04", fontsize=9.5];
  q3 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Can its schedule avoid\noverlap with the other\nproduction-like environment?", margin="0.04,0.04", fontsize=9.5];
  np1 [label="Shared group NP1\n(DEV, SIT, UAT)", fillcolor="#E2EFDA"];
  np2 [label="Shared group NP2\n(PERF, PREPROD)", fillcolor="#E2EFDA"];
  own [label="Own service set\n(extra cost, logged as a decision)", fillcolor="#FFF2CC"];
  start -> q1;
  q1 -> np1 [label="No"];
  q1 -> q2 [label="Yes"];
  q2 -> np1 [label="No"];
  q2 -> q3 [label="Yes"];
  q3 -> np2 [label="Yes"];
  q3 -> own [label="No"];

}
