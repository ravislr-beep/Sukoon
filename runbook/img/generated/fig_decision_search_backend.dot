digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB;
  start [label="Select search backend for SRS", shape=box, style="rounded,filled", fillcolor="#DCE6F2"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does Customer policy\nallow Elasticsearch\n(Elastic licence)?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Is a managed OpenSearch\nservice available in the\nAzure region with private\nconnectivity?", margin="0.04,0.04", fontsize=9.5];
  q3 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does the provider allow\nauto_create_index=false and\ndestructive_requires_name=false?", margin="0.04,0.04", fontsize=9.5];
  q4 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does the provider support an\nSRS auth method: basic, TLS,\nmTLS or PKI?", margin="0.04,0.04", fontsize=9.5];
  es [label="Elasticsearch 8.x from the\ncertified list\nimage: search-n-reporting-service", fillcolor="#E2EFDA"];
  os [label="Managed OpenSearch 2.19 or 2.15\nimage: search-n-reporting-service-os", fillcolor="#E2EFDA"];
  self [label="Self-managed OpenSearch\n(official images only) on a\ndedicated node pool; Customer\noperates it", fillcolor="#FFF2CC"];
  reject [label="Reject provider\nand re-evaluate", fillcolor="#F8CBAD"];
  start -> q1;
  q1 -> es [label="Yes"];
  q1 -> q2 [label="No (current\nbaseline D-08)"];
  q2 -> q3 [label="Yes"];
  q2 -> self [label="No"];
  q3 -> q4 [label="Yes"];
  q3 -> reject [label="No"];
  q4 -> os [label="Yes"];
  q4 -> reject [label="No"];
  es -> q3 [style=dashed, label="same checks apply"];

}
