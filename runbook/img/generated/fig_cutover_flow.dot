digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB; nodesep=0.3; ranksep=0.3;
  t0 [label="T-7d: Go/No-Go 1\nrehearsal evidence accepted", fillcolor="#FFF2CC"];
  t1 [label="Change freeze on 8.8; announce outage window", fillcolor="#DCE6F2"];
  t2 [label="Stop producers (web traffic and listeners)", fillcolor="#DCE6F2"];
  t3 [label="Run Stream Migration activity; poll until\nqueueSize=0, timeToDrainMS=0, COMPLETED", fillcolor="#DCE6F2"];
  t4 [label="Stop all 8.8 nodes; final database backup", fillcolor="#DCE6F2"];
  t5 [label="Restore database to target; installer job\nupdates it to the bridge release", fillcolor="#E4DFEC"];
  t6 [label="Deploy bridge tiers on AKS (new topic prefix);\nStream provider ExternalKafka / NORMAL", fillcolor="#E4DFEC"];
  t7 [label="Remove Hazelcast: set DSS, full stop and start,\nverify hazelcast/disabled = true", fillcolor="#E4DFEC"];
  t8 [label="Full index build (new customerDeploymentId);\nconfirm index status", fillcolor="#E4DFEC"];
  g2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Go/No-Go 2\nsmoke tests pass?", margin="0.04,0.04", fontsize=9.5];
  t9 [label="Switch public DNS to Application Gateway", fillcolor="#E2EFDA"];
  g3 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Go/No-Go 3\nfirst 30 minutes\nclean?", margin="0.04,0.04", fontsize=9.5];
  t10 [label="Soak period; release freeze; hypercare", fillcolor="#E2EFDA"];
  rb [label="Rollback (Section 15)", fillcolor="#F8CBAD"];
  t0 -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> t8 -> g2;
  g2 -> t9 [label="Yes"];
  g2 -> rb [label="No"];
  t9 -> g3;
  g3 -> t10 [label="Yes"];
  g3 -> rb [label="No"];

}
