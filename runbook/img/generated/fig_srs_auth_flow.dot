digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=LR;
  pega [label="Pega node\n(web or batch)", fillcolor="#DCE6F2"];
  idp [label="OAuth identity provider\ntoken endpoint", fillcolor="#FCE4D6"];
  srs [label="SRS\nAuthEnabled: true", fillcolor="#E4DFEC"];
  jwks [label="Public key URL\n(OAuthPublicKeyURL)", fillcolor="#FCE4D6"];
  os [label="Elasticsearch / OpenSearch\nindexes prefixed with\ncustomerDeploymentId", fillcolor="#E2EFDA"];
  pega -> idp [label="1 client credentials\n(private_key_jwt or client_secret_basic)\nscope pega.search:full"];
  idp -> pega [label="2 JWT with scp and guid claims", style=dashed];
  pega -> srs [label="3 request + bearer token"];
  srs -> jwks [label="4 fetch signing keys", style=dashed];
  srs -> os [label="5 TLS + basic auth, mTLS\nor PKI client certificate"];

}
