digraph G {

  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontcolor="#1F3864"];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#44546A", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#44546A", fontcolor="#595959", arrowsize=0.7, penwidth=1.0];


  rankdir=TB;
  start [label="Search indexes for each release", fillcolor="#DCE6F2"];
  q1 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does the source already\nuse SRS on the target\nsearch cluster?", margin="0.04,0.04", fontsize=9.5];
  q2 [shape=diamond, style="filled", fillcolor="#FFF2CC", label="Does the rehearsal show a\nfull index build fits the\noutage window?", margin="0.04,0.04", fontsize=9.5];
  r1 [label="Release 1: connect 8.8 to SRS and run\nthe full index build (Pega documented\npath; embedded and plug-in data\nare not migrated)", fillcolor="#E2EFDA"];
  newid [label="RECOMMENDED for Release 2:\nnew customerDeploymentId, full build;\nsource indexes stay intact for rollback", fillcolor="#E2EFDA"];
  reuse [label="Keep customerDeploymentId; check index\nstatus and re-index flagged classes;\nrollback needs a re-index on 8.8", fillcolor="#FFF2CC"];
  snap [label="Snapshot copy of SRS indexes:\nnot used. SRS owns index names and\nmappings; ES 8 snapshots do not\nrestore into OpenSearch", fillcolor="#F8CBAD"];
  start -> q1;
  q1 -> r1 [label="No (embedded or\nlegacy plug-in)"];
  q1 -> q2 [label="Yes"];
  q2 -> newid [label="Yes"];
  q2 -> reuse [label="No"];
  start -> snap [style=dashed, arrowhead=none];

}
